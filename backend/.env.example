# Base de datos y servidor
DATABASE_URL=postgres://user:password@localhost:5432/maqoo
JWT_SECRET=cambia-este-secreto
PORT=3000

# Reconocimiento de ingredientes
# Proveedor integrado: vision (Google Cloud Vision) o deja vacío para mocks/URL genérica
INGREDIENT_AI_PROVIDER=vision
# API key de Google Cloud Vision (obligatoria si provider=vision)
INGREDIENT_AI_KEY=tu_api_key_de_vision
# Opcional: endpoint custom si usas un proveedor multipart distinto (déjalo vacío para Vision)
INGREDIENT_AI_URL=

# Microservicio de tiendas (server/index.js)
# Puerto opcional para el microservicio de tiendas (por defecto 3001 si no se define)
PLACES_PORT=3001
# Proveedor: google o nominatim
PLACES_PROVIDER=google
PLACES_API_KEY=tu_api_key_de_google_maps
